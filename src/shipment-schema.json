{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shipment_id",
    "partner",
    "ship_date",
    "service_level",
    "ship_to",
    "items"
  ],
  "properties": {
    "shipment_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,80}$"
    },
    "partner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "ship_date": {
      "type": "string",
      "format": "date"
    },
    "service_level": {
      "type": "string",
      "enum": ["standard", "priority", "overnight"]
    },
    "ship_to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address_line1",
        "city",
        "state_or_province",
        "postal_code",
        "country_code"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "address_line1": {"type": "string", "minLength": 1, "maxLength": 120},
        "city": {"type": "string", "minLength": 1, "maxLength": 80},
        "state_or_province": {"type": "string", "minLength": 1, "maxLength": 80},
        "postal_code": {"type": "string", "minLength": 1, "maxLength": 20},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "description", "quantity", "unit_weight_kg"],
        "properties": {
          "sku": {"type": "string", "minLength": 1, "maxLength": 40},
          "description": {"type": "string", "minLength": 1, "maxLength": 120},
          "quantity": {"type": "integer", "minimum": 1, "maximum": 1000},
          "unit_weight_kg": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1000
          }
        }
      }
    }
  }
}
