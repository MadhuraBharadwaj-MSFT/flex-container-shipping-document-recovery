{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {"value": "${AZURE_ENV_NAME}"},
    "location": {"value": "${AZURE_LOCATION=eastus2}"},
    "functionLocation": {"value": "${AZURE_FUNCTION_LOCATION=eastus2euap}"},
    "connectorLocation": {"value": "${CONNECTOR_LOCATION=westcentralus}"},
    "foundryModel": {"value": "${FOUNDRY_MODEL=gpt-5.4}"},
    "foundryModelVersion": {"value": "${FOUNDRY_MODEL_VERSION=2026-03-05}"},
    "foundryModelCapacity": {"value": "${FOUNDRY_MODEL_CAPACITY=100}"},
    "developerPrincipalId": {"value": "${DEVELOPER_PRINCIPAL_ID=}"},
    "demoOwnerId": {"value": "${DEMO_OWNER_ID=}"}
  }
}
